rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function accountApproved() { return signedIn() && (userDoc().data.role == 'Admin' || userDoc().data.accountStatus == 'Disetujui'); }
    function hasRole(role) { return accountApproved() && userDoc().data.role == role; }
    function admin() { return hasRole('Admin'); }
    function studentOwns(studentId) { return accountApproved() && studentId == request.auth.uid; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin() || hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'Mahasiswa'
        && request.resource.data.accountStatus == 'Menunggu verifikasi'
        && request.resource.data.requestedRole in ['Mahasiswa', 'Dosen Pembimbing', 'Pembimbing Lapangan']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && (request.resource.data.requestedRole == 'Mahasiswa'
          ? request.resource.data.nim is string && request.resource.data.nim.size() >= 5
            && request.resource.data.nim.size() <= 20 && request.resource.data.programStudi is string
            && request.resource.data.programStudi.size() > 0
          : request.resource.data.unitKerja is string && request.resource.data.unitKerja.size() > 0);
      allow update: if admin();
      allow delete: if admin();
    }

    match /logbooks/{logId} {
      allow read: if signedIn() && (admin() || studentOwns(resource.data.studentId)
        || hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'));
      allow create: if signedIn() && hasRole('Mahasiswa')
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'Menunggu';
      allow update: if admin() || (signedIn() && hasRole('Pembimbing Lapangan')
        && resource.data.status == 'Menunggu'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewComment'])
        && request.resource.data.reviewComment is string
        && request.resource.data.reviewComment.size() <= 1000
        && request.resource.data.status in ['Disetujui', 'Perlu revisi']);
      allow delete: if admin() || (signedIn() && hasRole('Mahasiswa')
        && resource.data.studentId == request.auth.uid && resource.data.status == 'Menunggu');
    }

    match /evaluations/{evaluationId} {
      allow read: if signedIn() && (admin() || studentOwns(resource.data.studentId)
        || hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'));
      allow create: if signedIn() && (hasRole('Admin') || hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'))
        && request.resource.data.evaluatorId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100;
      allow update, delete: if admin();
    }
  }
}
