rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function accountApproved() {
      return signedIn() && (userDoc().data.role == 'Admin'
        || !userDoc().data.keys().hasAny(['accountStatus'])
        || userDoc().data.accountStatus == 'Disetujui');
    }
    function hasRole(role) { return accountApproved() && userDoc().data.role == role; }
    function admin() { return hasRole('Admin'); }
    function studentOwns(studentId) { return accountApproved() && studentId == request.auth.uid; }
    function isApprovedStudent(studentId) {
      let student = get(/databases/$(database)/documents/users/$(studentId)).data;
      return student.role == 'Mahasiswa'
        && (!student.keys().hasAny(['accountStatus']) || student.accountStatus == 'Disetujui');
    }
    function evaluationWindowOpen() {
      return exists(/databases/$(database)/documents/appSettings/evaluation)
        && get(/databases/$(database)/documents/appSettings/evaluation).data.open == true;
    }
    function validFinalRubric() {
      let scores = request.resource.data.criteriaScores;
      return scores is map
        && scores.keys().hasOnly(['sikap', 'kerajinan', 'prestasi'])
        && scores.keys().hasAll(['sikap', 'kerajinan', 'prestasi'])
        && scores.sikap in [50, 60, 65, 70, 75, 80, 85, 90, 100]
        && scores.kerajinan in [50, 60, 65, 70, 75, 80, 85, 90, 100]
        && scores.prestasi in [50, 60, 65, 70, 75, 80, 85, 90, 100]
        && request.resource.data.score == (scores.sikap + scores.kerajinan + scores.prestasi) / 3
        && request.resource.data.type == 'Penilaian Akhir'
        && request.resource.data.grade == (request.resource.data.score >= 85 ? 'A'
          : request.resource.data.score > 80 ? 'A-'
          : request.resource.data.score >= 75 ? 'B+'
          : request.resource.data.score >= 70 ? 'B'
          : request.resource.data.score >= 65 ? 'B-'
          : request.resource.data.score >= 50 ? 'C'
          : request.resource.data.score >= 40 ? 'D' : 'E')
        && request.resource.data.keys().hasOnly(['studentId', 'criterion', 'criteriaScores', 'score', 'grade', 'type', 'note', 'date', 'studentName', 'evaluatorId', 'evaluatorName', 'evaluatorRole', 'createdAt']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin() || hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'Mahasiswa'
        && request.resource.data.accountStatus == 'Menunggu verifikasi'
        && request.resource.data.requestedRole in ['Mahasiswa', 'Dosen Pembimbing', 'Pembimbing Lapangan']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && (request.resource.data.requestedRole == 'Mahasiswa'
          ? request.resource.data.nim is string && request.resource.data.nim.size() >= 5
            && request.resource.data.nim.size() <= 20 && request.resource.data.programStudi is string
            && request.resource.data.programStudi.size() > 0
          : request.resource.data.unitKerja is string && request.resource.data.unitKerja.size() > 0);
      allow update: if admin();
      allow delete: if admin();
    }

    match /profilePhotos/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['photoData', 'updatedAt'])
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 250000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /logbooks/{logId} {
      allow read: if signedIn() && (admin() || studentOwns(resource.data.studentId)
        || hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'));
      allow create: if signedIn()
        && ((hasRole('Mahasiswa')
            && request.resource.data.studentId == request.auth.uid
            && request.resource.data.status == 'Menunggu')
          || (admin()
            && request.resource.data.studentId is string
            && get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.role == 'Mahasiswa'
            && request.resource.data.status in ['Menunggu', 'Disetujui', 'Perlu revisi']))
        && request.resource.data.photoEvidenceId == logId;
      allow update: if admin() || (signedIn() && hasRole('Pembimbing Lapangan')
        && resource.data.status == 'Menunggu'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewComment'])
        && request.resource.data.reviewComment is string
        && request.resource.data.reviewComment.size() <= 1000
        && request.resource.data.status in ['Disetujui', 'Perlu revisi']);
      allow delete: if admin() || (signedIn() && hasRole('Mahasiswa')
        && resource.data.studentId == request.auth.uid && resource.data.status == 'Menunggu');
    }

    match /logbookPhotos/{photoId} {
      allow read: if signedIn() && (admin() || studentOwns(resource.data.studentId)
        || hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'));
      allow create: if signedIn()
        && ((hasRole('Mahasiswa') && request.resource.data.studentId == request.auth.uid) || admin())
        && request.resource.data.studentId is string
        && request.resource.data.keys().hasOnly(['photoData', 'studentId', 'createdAt'])
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 700000;
      allow update, delete: if admin();
    }

    match /evaluations/{evaluationId} {
      allow read: if signedIn() && (admin() || studentOwns(resource.data.studentId)
        || hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'));
      allow create: if signedIn()
        && request.resource.data.evaluatorId == request.auth.uid
        && (admin()
          || (evaluationWindowOpen() && hasRole('Dosen Pembimbing')
            && request.resource.data.studentId is string
            && isApprovedStudent(request.resource.data.studentId)
            && request.resource.data.score is number
            && request.resource.data.score >= 0 && request.resource.data.score <= 100)
          || (evaluationWindowOpen() && hasRole('Pembimbing Lapangan')
            && request.resource.data.studentId is string
            && isApprovedStudent(request.resource.data.studentId)
            && request.resource.data.criteriaScores is map
            && validFinalRubric()));
      allow update, delete: if admin();
    }

    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if admin() && settingId == 'evaluation'
        && request.resource.data.keys().hasOnly(['open', 'updatedBy', 'updatedAt'])
        && request.resource.data.open is bool
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if admin() && settingId == 'evaluation';
    }

    match /activityEvents/{eventId} {
      allow read: if signedIn() && (resource.data.recipientUid == request.auth.uid
        || resource.data.recipientRole == userDoc().data.role);
      allow create: if accountApproved()
        && request.resource.data.keys().hasOnly([
          'eventType', 'title', 'message', 'actorUid', 'actorName', 'actorRole',
          'recipientUid', 'recipientRole', 'entityId', 'studentId', 'createdAt', 'read'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == userDoc().data.role
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.recipientUid == request.auth.uid
            && request.resource.data.read == true)
          || (admin()
            && ((request.resource.data.recipientUid is string
                && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)))
              || (request.resource.data.recipientRole == 'Pembimbing Lapangan'
                && request.resource.data.eventType in ['evaluation_access_changed', 'logbook_created'])))
          || (hasRole('Pembimbing Lapangan')
            && request.resource.data.eventType == 'logbook_reviewed'
            && request.resource.data.recipientUid == request.resource.data.studentId
            && get(/databases/$(database)/documents/logbooks/$(request.resource.data.entityId)).data.studentId == request.resource.data.studentId
            && get(/databases/$(database)/documents/logbooks/$(request.resource.data.entityId)).data.reviewedBy == request.auth.uid)
          || ((hasRole('Dosen Pembimbing') || hasRole('Pembimbing Lapangan'))
            && request.resource.data.eventType == 'evaluation_created'
            && request.resource.data.recipientUid == request.resource.data.studentId
            && get(/databases/$(database)/documents/evaluations/$(request.resource.data.entityId)).data.studentId == request.resource.data.studentId
            && get(/databases/$(database)/documents/evaluations/$(request.resource.data.entityId)).data.evaluatorId == request.auth.uid)
          || (hasRole('Mahasiswa')
            && request.resource.data.eventType == 'logbook_created'
            && request.resource.data.recipientRole == 'Pembimbing Lapangan'
            && get(/databases/$(database)/documents/logbooks/$(request.resource.data.entityId)).data.studentId == request.auth.uid)
        );
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;
      allow delete: if admin() || (signedIn() && resource.data.recipientUid == request.auth.uid);
    }
  }
}
